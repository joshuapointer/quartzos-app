{
  "expo": {
    "name": "Quartzie",
    "slug": "quartzos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#120C1F"
    },
    "ios": {
      "bundleIdentifier": "com.quartzos.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Quartzie connects to your Dab Rite to read temperature and sync settings.",
        "NSBluetoothPeripheralUsageDescription": "Quartzie connects to your Dab Rite to read temperature and sync settings.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.quartzos.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#120C1F"
      },
      "permissions": [
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Quartzie needs Bluetooth to communicate with your Dab Rite."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 36,
            "targetSdkVersion": 35
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/dab_alarm.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "quartzos",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf01e852-e296-4c49-88e8-a9b709c17cab"
      }
    },
    "owner": "joshpointer-dev"
  }
}
