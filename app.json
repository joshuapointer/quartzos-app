{
  "expo": {
    "name": "dabwith.me",
    "slug": "quartzos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.dabwith.me",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "dabwith.me connects to your Dab Rite to read temperature and sync settings.",
        "NSBluetoothPeripheralUsageDescription": "dabwith.me connects to your Dab Rite to read temperature and sync settings.",
        "UIBackgroundModes": ["bluetooth-central", "fetch"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dabwith.me",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#1a1410"
      },
      "permissions": [
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1a1410",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1a1410"
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Quartzie needs Bluetooth to communicate with your Dab Rite."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 36,
            "targetSdkVersion": 35
          },
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ],
      "./modules/quartzie-siri-bridge/plugin/build/index.js",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/dab_alarm.wav"]
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/bf01e852-e296-4c49-88e8-a9b709c17cab",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "quartzos",
    "web": {
      "favicon": "./public/favicon.ico",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf01e852-e296-4c49-88e8-a9b709c17cab"
      }
    },
    "owner": "joshpointer-dev"
  }
}
